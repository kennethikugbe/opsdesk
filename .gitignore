# Local Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local database and settings (never commit real secrets or user data)
instance/
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
.env
.env.*
!.env.example

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Terraform's local artifacts and potentially sensitive state
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log

# OpsDesk additional ignore safeguards
# Local databases and SQLite companion files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3-journal

# Common private-key files and credential containers
.ssh/
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.key
*.pem
*.p8
*.p12
*.pfx
